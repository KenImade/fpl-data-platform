premierlytics.com, www.premierlytics.com {
    root * /srv/docs

    encode gzip zstd

    try_files {path} {path}/ /index.html

    file_server
}

{$API_DOMAIN} {
    encode gzip zstd

    reverse_proxy api:8000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        -Server
    }
}

{$DAGSTER_DOMAIN} {
    basic_auth {
        admin {$DAGSTER_BASIC_AUTH}
    }

    reverse_proxy dagster-web:3000
}