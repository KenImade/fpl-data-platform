# # Copy to .env on the host. NEVER commit the real thing.

API_DOMAIN=api.example.com
DAGSTER_DOMAIN=pipeline.example.com
ACME_EMAIL=you@example.com

# Generate: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'yourpassword'
DAGSTER_BASIC_AUTH=$2a$14$...

POSTGRES_USER=fpl
POSTGRES_PASSWORD= # openssl rand -base64 32
POSTGRES_DB=fpl

API_DB_USER=fpl_api
API_DB_PASSWORD= # openssl rand -base64 32

S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=fpl-bronze

USER_AGENT=fpl-api-project (contact: you@example.com)
HEARTBEAT_URL=https://hc-ping.com/<uuid>
BACKUP_HEARTBEAT_URL=https://hc-ping.com/<uuid>

CORS_ORIGINS=*
GIT_SHA=
